{
  "name": "devcontainer",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.37.2",
      "kubectl_sha256": "c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4",
      "helm": "4.3.1",
      "helm_sha256": "0403a88ae20913d11b10a2467b50087721fea7581736da6b9d3992f5357fe54b",
      "minikube": "none"
    },
    "ghcr.io/dhoeric/features/k9s:1": {
      "version": "0.51.0"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes@sha256:6a8b044f9f424097ec6d212167836b26994a76a556cbcb202084be79fe8032bd": {
      "jqVersion": "1.8.1",
      "yqVersion": "4.40.1",
      "gojqVersion": "none",
      "xqVersion": "none"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "hashicorp.terraform",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Tim-Koehler.helm-intellisense",
        "timonwong.shellcheck"
      ],
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.languageServer.args": [
          "serve"
        ]
      }
    }
  },
  "remoteEnv": {
    "GIT_EDITOR": "vim"
  },
  "workspaceMount": "source=${localWorkspaceFolder}/repos,target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localEnv:HOME}\/.kube,target=/home/vscode/.kube,type=bind",
    "source=${localEnv:HOME}\/.ssh,target=/home/vscode/.ssh,type=bind",

    "source=${localWorkspaceFolder}/repos/.history,target=/home/vscode/.history,type=bind",
    "source=${localWorkspaceFolder}/repos/.config,target=/home/vscode/.config,type=bind",
    "source=${localWorkspaceFolder}/repos/.local,target=/home/vscode/.local,type=bind"
  ],
  "postCreateCommand": "helm plugin install https://github.com/databus23/helm-diff || echo 'plugin helm-diff already installed' "
}
  