{
  "name": "ubuntu",
//  "remoteUser": "marcus",
//  "containerUser": "vscode",'
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.37.0",
      //"kubectl_sha256":
      "helm": "4.2.4",
      //"helm_sha256": 
      "minikube": "none"
    },
    "ghcr.io/dhoeric/features/k9s:1": {
      "version": "0.51.0"
    },
    "ghcr.io/eitsupi/devcontainer-features/jq-likes@sha256:6a8b044f9f424097ec6d212167836b26994a76a556cbcb202084be79fe8032bd": {
      "jqVersion": "1.8.1",
      "yqVersion": "4.40.1",
      "gojqVersion": "none",
      "xqVersion": "none"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "christian-kohler.path-intellisense",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "hashicorp.terraform",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "Tim-Koehler.helm-intellisense",
        "timonwong.shellcheck"
      ],
      "settings": {
        "terraform.languageServer.enable": true,
        "terraform.languageServer.args": [
          "serve"
        ]
      }
    }
  },
  "remoteEnv": {
    "GIT_EDITOR": "vim"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localEnv:HOME}\/.kube,target=/home/vscode/.kube,type=bind",
    "source=${localEnv:HOME}\/.ssh,target=/home/vscode/.ssh,type=bind",

    "source=${localWorkspaceFolder}/.history,target=/home/vscode/.history,type=bind",
    "source=${localWorkspaceFolder}/.config,target=/home/vscode/.config,type=bind",
    "source=${localWorkspaceFolder}/.local,target=/home/vscode/.local,type=bind"
  ],
  "postCreateCommand": "helm plugin install https://github.com/databus23/helm-diff || echo 'plugin helm-diff already installed' ",
  //"postStartCommand": "sudo bash -c \"hostname $HOSTNAME; echo $(hostname -I | cut -d' ' -f2) $HOSTNAME >> /etc/hosts\""
}
  